{
  "name": "michel/paper-orm-benchmark",
  "description": "Standalone benchmark comparing PaperORM with Doctrine ORM. Not part of the paper-orm package.",
  "type": "project",
  "license": "MPL-2.0",
  "repositories": [
    {
      "type": "path",
      "url": "..",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-pdo_sqlite": "*",
    "michel/paper-orm": "*@dev",
    "doctrine/orm": "^3.0",
    "symfony/cache": "^6.4 || ^7.0 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "Bench\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  }
}
